package com.oxnull.betterchunkculling.mixin;

import com.oxnull.betterchunkculling.BCCConfig;
import com.oxnull.betterchunkculling.BetterChunkCulling;
import net.minecraft.client.renderer.RenderGlobal;
import net.minecraft.client.renderer.culling.ICamera;
import net.minecraft.entity.Entity;
import org.spongepowered.asm.mixin.Mixin;
import org.spongepowered.asm.mixin.Unique;
import org.spongepowered.asm.mixin.injection.At;
import org.spongepowered.asm.mixin.injection.Inject;
import org.spongepowered.asm.mixin.injection.callback.CallbackInfo;

/**
 * Esto es un debug (o tambien un pisapapeles) que solo funciona en el RunClient esto lo hice porque el mod no funcionaba como debida
 */
@Mixin(RenderGlobal.class)
public abstract class MixinRenderGlobal {

    @Unique
    private static int bcc$tickCount = 0;

    // Inyecta al final de setupTerrain para confirmar que los Mixin esta activo
    @Inject(method = "setupTerrain", at = @At("RETURN"))
    private void betterchunkculling$heartbeat(
            Entity viewEntity,
            double partialTicks,
            ICamera camera,
            int frameCount,
            boolean playerSpectator,
            CallbackInfo ci
    ) {
        bcc$tickCount++;
        
        if (bcc$tickCount % 200 == 1 && BCCConfig.debug) {
            BetterChunkCulling.logger.info(
                    "[BCC] Active mixin - Frame {}, verticalStretch={}",
                    frameCount, BCCConfig.verticalStretch
            );
        }
    }
}
